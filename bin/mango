#!/usr/bin/env bash
# Mango — interactive terminal UI for Ty's Toolkit Hub

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# Lightweight subcommands (no UI libs — must work during uninstall / partial installs)
case "${1:-}" in
  doctor)
    shift
    exec "$ROOT/bin/mango-doctor" "$@"
    ;;
  uninstall)
    shift
    exec "$ROOT/uninstall.sh" "$@"
    ;;
  help|--help|-h)
    cat <<'EOF'
Mango — offline toolkit hub

Usage:
  mango                 Open the interactive UI
  mango doctor          Check dependencies
  mango uninstall       Remove global commands (and optional install dir)
  mango uninstall --purge
  mango uninstall --keep-data
  mango help            Show this help
EOF
    exit 0
    ;;
esac

# shellcheck source=../lib/mango-ui.sh
source "$ROOT/lib/mango-ui.sh"
# shellcheck source=../lib/mango-deps.sh
source "$ROOT/lib/mango-deps.sh"

BIN="$ROOT/bin"

# ── Tool registry ─────────────────────────────────────────────────────────────
# Each tool: id|label|category|script|input_exts|output_ext|status
#   input_exts: comma-separated (e.g. mp4,mov)
#   status: ready | soon

MANGO_TOOLS=(
  "video-to-gif|Video → GIF|Video & Audio|to_gif|mp4,mov,webm,mkv,avi|gif|ready"
  "extract-audio|Extract Audio|Video & Audio|extract-audio|mp4,mov,mkv,webm|mp3|ready"
  "trim-media|Trim Media|Video & Audio|trim-media|mp4,mov,mkv,webm|mp4|ready"
  "compress-video|Compress Video|Video & Audio|compress-video|mp4,mov,webm,mkv,avi|mp4|ready"
  "compress-image|Compress Image|Image|compress-image|jpg,jpeg,png,webp,gif|same|ready"
  "convert-image|Convert Image|Image|convert-image|jpg,jpeg,png,webp,gif,bmp|same|ready"
  "strip-exif|Strip EXIF|Image|strip-exif|jpg,jpeg,png,webp|same|ready"
  "pdf-to-word|PDF → Word|PDF|pdftoword|pdf|docx|ready"
  "merge-pdf|Merge PDFs|PDF|merge-pdf|pdf|pdf|ready"
  "split-pdf|Split PDF|PDF|split-pdf|pdf|pdf|ready"
  "rotate-pdf|Rotate PDF|PDF|rotate-pdf|pdf|pdf|ready"
  "jpg-to-pdf|Images → PDF|PDF|jpg-to-pdf|jpg,jpeg,png,webp|pdf|ready"
  "pdf-to-jpg|PDF → JPG|PDF|pdf-to-jpg|pdf|jpg|ready"
  "compress-pdf|Compress PDF|PDF|compress-pdf|pdf|pdf|ready"
  "format-json|Format JSON|Developer|format-json|json|json|ready"
  "hash-gen|Hash File|Developer|hash-gen|any|any|ready"
  "base64-tool|Base64 Encode/Decode|Developer|base64-tool|any|any|ready"
  "csv-to-json|CSV → JSON|Developer|csv-to-json|csv|json|ready"
)

_mango_tool_field() {
  local id="$1" field="$2" row part
  for row in "${MANGO_TOOLS[@]}"; do
    IFS='|' read -r tid _ _ _ _ _ _ <<< "$row"
    if [[ "$tid" == "$id" ]]; then
      IFS='|' read -r _ label category script in_exts out_ext status <<< "$row"
      case "$field" in
        label)    echo "$label" ;;
        category) echo "$category" ;;
        script)   echo "$script" ;;
        in_exts)  echo "$in_exts" ;;
        out_ext)  echo "$out_ext" ;;
        status)   echo "$status" ;;
      esac
      return 0
    fi
  done
  return 1
}

_mango_tool_by_index() {
  local idx="$1"
  local i=0 row
  for row in "${MANGO_TOOLS[@]}"; do
    if [[ "$i" -eq "$idx" ]]; then
      echo "$row"
      return 0
    fi
    ((i++)) || true
  done
  return 1
}

_mango_ext_matches() {
  local file_ext="$1"
  local allowed="$2"
  file_ext=$(printf '%s' "$file_ext" | tr '[:upper:]' '[:lower:]')
  local ext
  IFS=',' read -ra parts <<< "$allowed"
  for ext in "${parts[@]}"; do
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    [[ "$ext" == "any" || "$ext" == "various" || "$ext" == "same" ]] && return 0
    [[ "$file_ext" == "$ext" ]] && return 0
  done
  return 1
}

_mango_script_ready() {
  local script="$1"
  [[ -z "$script" ]] && return 1
  [[ -x "$BIN/$script" ]] || return 1
  return 0
}

_mango_exit_app() {
  _mango_tui_leave
  ui_clear
  echo ""
  echo -e "  ${MANGO_FG_MANGO}${MANGO_BOLD}Thanks for using Mango!${MANGO_RESET}"
  echo ""
  exit 0
}

# ── Video compression ratio picker ─────────────────────────────────────────────

_mango_vc_draw_page() {
  ui_header
  ui_title_bar "Compress Video"
  ui_breadcrumb "Home" "Video & Audio" "Compress Video"
  ui_box_open "Original"
  ui_box_line "  ${MANGO_WHITE}${MANGO_BOLD}${_MANGO_VC_NAME}${MANGO_RESET}  ${MANGO_DIM}${_MANGO_VC_META}${MANGO_RESET}"
  ui_box_close
  echo ""
}

# Sets _MANGO_VC_RATIO (preset id) and _MANGO_VC_EST (human size). Returns 1 on cancel.
_mango_pick_compress_ratio() {
  local input="$1"
  local plan kind id percent label bytes rec orig_bytes secs res
  local -a ids=() labels=() estimates=()
  local rec_index=0 i=0

  _MANGO_VC_RATIO=""
  _MANGO_VC_EST=""
  _MANGO_VC_NAME="$(basename "$input")"
  _MANGO_VC_META=$(_mango_file_size "$input")

  plan=$("$BIN/compress-video" "$input" --plan 2>/dev/null) || plan=""
  if [[ -z "$plan" ]]; then
    ui_message warning "Could not probe the video for size estimates."
    ui_prompt_default "Compression ratio (best, 80, 50, 25, 10)" "50" _MANGO_VC_RATIO
    _MANGO_VC_EST=""
    return 0
  fi

  while IFS='|' read -r kind id percent label bytes rec; do
    case "$kind" in
      ORIG)
        orig_bytes="$id"
        secs="$percent"
        res="$label"
        _MANGO_VC_META="$(_mango_fmt_bytes "$orig_bytes")"
        if [[ -n "$secs" ]]; then
          _MANGO_VC_META+="  ·  $(awk -v s="$secs" 'BEGIN {
            s = int(s + 0.5)
            h = int(s / 3600); m = int((s % 3600) / 60); sec = s % 60
            if (h > 0) printf "%d:%02d:%02d", h, m, sec
            else printf "%d:%02d", m, sec
          }')"
        fi
        [[ -n "$res" && "$res" != "unknown" ]] && _MANGO_VC_META+="  ·  ${res}"
        ;;
      PRESET)
        ids+=("$id")
        estimates+=("$bytes")
        if [[ "$rec" == "1" ]]; then
          rec_index=$i
          labels+=("${label}|~$(_mango_fmt_bytes "$bytes")  ·  recommended")
        else
          labels+=("${label}|~$(_mango_fmt_bytes "$bytes")")
        fi
        ((i++)) || true
        ;;
    esac
  done <<< "$plan"

  if [[ ${#ids[@]} -eq 0 ]]; then
    _MANGO_VC_RATIO="50"
    return 0
  fi

  labels+=("Back|")
  _MANGO_PAGE_DRAW_FN=_mango_vc_draw_page
  MANGO_MENU_FOOTER="${MANGO_DIM}Estimated size after compression${MANGO_RESET}"
  MANGO_MENU_INITIAL="$rec_index"

  local choice
  ui_menu_select choice page main "Compression ratio" "${labels[@]}"
  _MANGO_PAGE_DRAW_FN=""
  MANGO_MENU_FOOTER=""

  if [[ "$choice" -eq ${#labels[@]} ]]; then
    return 1
  fi

  _MANGO_VC_RATIO="${ids[$((choice - 1))]}"
  _MANGO_VC_EST="$(_mango_fmt_bytes "${estimates[$((choice - 1))]}")"
  return 0
}

# ── Conversion runner ───────────────────────────────────────────────────────────

_mango_run_conversion() {
  local tool_id="$1"
  local label category script in_exts out_ext status
  label=$(_mango_tool_field "$tool_id" label)
  category=$(_mango_tool_field "$tool_id" category)
  script=$(_mango_tool_field "$tool_id" script)
  in_exts=$(_mango_tool_field "$tool_id" in_exts)
  out_ext=$(_mango_tool_field "$tool_id" out_ext)
  status=$(_mango_tool_field "$tool_id" status)

  ui_tool_header "$label" "$category"
  ui_breadcrumb "Home" "$category" "$label"

  if [[ "$status" != "ready" ]] || ! _mango_script_ready "$script"; then
    ui_message info "This tool is coming soon — check back after the next update."
    ui_pause
    return 0
  fi

  if ! mango_tool_deps_ok "$tool_id"; then
    ui_message error "Missing dependency for ${label}."
    ui_box_open "Install"
    while IFS= read -r line; do
      if [[ -z "$line" ]]; then
        ui_box_line ""
      else
        ui_box_line "  ${line}"
      fi
    done < <(mango_tool_deps_install_guide "$tool_id")
    ui_box_line "  ${MANGO_DIM}Verify: mango doctor${MANGO_RESET}"
    ui_box_close
    echo ""
    ui_pause
    return 0
  fi

  local -a ext_array=()
  IFS=',' read -ra ext_array <<< "$in_exts"

  local input output
  local -a inputs=()
  if [[ "$tool_id" == "jpg-to-pdf" ]]; then
    if ! ui_prompt_image_folder "Path to images or a folder (drag & drop works)" inputs "${ext_array[@]}"; then
      ui_message info "Cancelled."
      ui_pause
      return 0
    fi
    input="${inputs[0]}"
  elif ! ui_prompt_file "Path to input file (drag & drop works)" input "${ext_array[@]}"; then
    ui_message info "Cancelled."
    ui_pause
    return 0
  else
    inputs=("$input")
  fi

  local suggested out_dir
  out_dir="$(dirname "$input")"
  if [[ "$tool_id" == "split-pdf" ]]; then
    suggested="$(dirname "$input")/$(basename "${input%.*}")-pages"
  elif [[ "$tool_id" == "pdf-to-jpg" ]]; then
    suggested="$(dirname "$input")/$(basename "${input%.*}")-jpg"
  elif [[ "$tool_id" == "jpg-to-pdf" && ${#inputs[@]} -gt 1 ]]; then
    suggested=$(ui_suggest_merged_output "$out_dir" "merged_pdf" "pdf")
  elif [[ "$tool_id" == "merge-pdf" ]]; then
    suggested=$(ui_suggest_merged_output "$out_dir" "merged_pdf" "pdf")
  elif [[ "$tool_id" == "compress-video" ]]; then
    suggested="$(dirname "$input")/$(basename "${input%.*}")_compressed.mp4"
  elif [[ "$out_ext" == "same" ]]; then
    output="$input"
    suggested=""
  else
    suggested=$(ui_suggest_output "$input" "$out_ext")
  fi

  if [[ "$out_ext" == "same" ]]; then
    :
  elif [[ "$tool_id" == "jpg-to-pdf" ]]; then
    ui_conversion_preview_multi "$suggested" "Preview" "${inputs[@]}"
    ui_box_open "Name this PDF"
    ui_box_line "  ${MANGO_DIM}Default is dated so it won't overwrite an older merge.${MANGO_RESET}"
    ui_box_line "  ${MANGO_DIM}Type a name (e.g. slides) or a full path. Enter keeps the default.${MANGO_RESET}"
    ui_box_close
    echo ""
    ui_prompt_default "Output filename" "$(basename "$suggested")" output
    output=$(ui_resolve_output_path "$output" "$out_dir" "pdf")
  elif [[ "$tool_id" == "merge-pdf" ]]; then
    ui_conversion_preview "$input" "$suggested" "Preview"
    ui_box_open "Name this PDF"
    ui_box_line "  ${MANGO_DIM}Default is dated so it won't overwrite an older merge.${MANGO_RESET}"
    ui_box_line "  ${MANGO_DIM}Type a name (e.g. packet) or a full path. Enter keeps the default.${MANGO_RESET}"
    ui_box_close
    echo ""
    ui_prompt_default "Output filename" "$(basename "$suggested")" output
    output=$(ui_resolve_output_path "$output" "$out_dir" "pdf")
  else
    ui_conversion_preview "$input" "$suggested" "Preview"
    ui_prompt_default "Output path" "$suggested" output
    output=$(_mango_expand_path "$output")
  fi

  local trim_start="" trim_end=""
  if [[ "$tool_id" == "trim-media" ]]; then
    ui_prompt_default "Start time (e.g. 0:05 or 1:30)" "0:00" trim_start
    ui_prompt_default "End time (blank = end of file)" "" trim_end
  fi

  local compress_ratio=""
  if [[ "$tool_id" == "compress-video" ]]; then
    if ! _mango_pick_compress_ratio "$input"; then
      ui_message info "Cancelled."
      ui_pause
      return 0
    fi
    compress_ratio="$_MANGO_VC_RATIO"
  fi

  if [[ "$tool_id" == "jpg-to-pdf" ]]; then
    ui_conversion_preview_multi "$output" "Ready to convert" "${inputs[@]}"
  else
    ui_conversion_preview "$input" "$output" "Ready to convert"
  fi
  if [[ "$tool_id" == "compress-video" ]]; then
    ui_box_open "Ratio"
    if [[ -n "${_MANGO_VC_EST:-}" ]]; then
      ui_box_line "  ${MANGO_WHITE}${compress_ratio}${MANGO_RESET}  ${MANGO_DIM}about ${_MANGO_VC_EST}${MANGO_RESET}"
    else
      ui_box_line "  ${MANGO_WHITE}${compress_ratio}${MANGO_RESET}"
    fi
    ui_box_close
    echo ""
  fi

  if ! ui_confirm "Start conversion?"; then
    ui_message info "Cancelled."
    ui_pause
    return 0
  fi

  local -a cmd=("$BIN/$script")

  case "$tool_id" in
    video-to-gif)
      cmd+=("$input" "-o" "$output")
      ;;
    compress-image|strip-exif)
      cmd+=("$input")
      if [[ "$output" != "$input" ]]; then
        cmd+=("-o" "$output")
      fi
      ;;
    convert-image)
      cmd+=("$input" "-o" "$output")
      ;;
    pdf-to-word)
      cmd+=("$input" "-o" "$output")
      ;;
    rotate-pdf|compress-pdf)
      cmd+=("$input" "-o" "$output")
      ;;
    pdf-to-jpg|split-pdf)
      cmd+=("$input" "-o" "$output")
      ;;
    jpg-to-pdf)
      cmd+=("${inputs[@]}" "-o" "$output")
      ;;
    merge-pdf)
      cmd+=("$input" "-o" "$output")
      ;;
    extract-audio)
      cmd+=("$input" "-o" "$output")
      ;;
    trim-media)
      cmd+=("$input" "-s" "$trim_start" "-o" "$output")
      [[ -n "$trim_end" ]] && cmd+=("-e" "$trim_end")
      ;;
    compress-video)
      cmd+=("$input" "-o" "$output" "--ratio" "$compress_ratio")
      ;;
    format-json|csv-to-json|base64-tool)
      cmd+=("$input" "-o" "$output")
      ;;
    hash-gen)
      cmd+=("$input")
      ;;
    *)
      cmd+=("$input" "$output")
      ;;
  esac

  ui_run_tool "$label" "${cmd[@]}" || true
  ui_pause
}

_mango_quick_convert_draw_page() {
  ui_header
  ui_title_bar "Quick Convert"
  ui_breadcrumb "Home" "Quick Convert"

  if [[ -z "${_MANGO_QC_INPUT:-}" ]]; then
    ui_box_open "How it works"
    ui_box_line "  ${MANGO_DIM}1.${MANGO_RESET} Pick any file"
    ui_box_line "  ${MANGO_DIM}2.${MANGO_RESET} Mango shows every conversion available for that type"
    ui_box_line "  ${MANGO_DIM}3.${MANGO_RESET} Choose one and go"
    ui_box_close
    echo ""
  else
    local in_base size
    in_base=$(basename "$_MANGO_QC_INPUT")
    size=$(_mango_file_size "$_MANGO_QC_INPUT")
    ui_box_open "Selected"
    ui_box_line "  ${MANGO_WHITE}${MANGO_BOLD}${in_base}${MANGO_RESET}  ${MANGO_DIM}${size}${MANGO_RESET}"
    ui_box_close
    echo ""
  fi
}

_mango_category_draw_page() {
  ui_header
  ui_title_bar "$_MANGO_CAT_NAME"
  ui_breadcrumb "Home" "$_MANGO_CAT_NAME"
}

# ── Quick convert: pick file first, then see options ────────────────────────────

_mango_quick_convert() {
  _MANGO_QC_INPUT=""
  _MANGO_PAGE_DRAW_FN=_mango_quick_convert_draw_page
  MANGO_MENU_FOOTER=""

  local input
  if ! ui_prompt_file "Path to your file" input; then
    return 0
  fi
  _MANGO_QC_INPUT="$input"

  local file_ext
  file_ext="${input##*.}"
  file_ext=$(printf '%s' "$file_ext" | tr '[:upper:]' '[:lower:]')

  local -a matches=()
  local row tid label category script in_exts out_ext status
  for row in "${MANGO_TOOLS[@]}"; do
    IFS='|' read -r tid label category script in_exts out_ext status <<< "$row"
    if _mango_ext_matches "$file_ext" "$in_exts"; then
      matches+=("$row")
    fi
  done

  if [[ ${#matches[@]} -eq 0 ]]; then
    ui_message warning "No conversions registered for .${file_ext} files yet."
    ui_pause
    return 0
  fi

  local -a menu_items=()
  local i=0
  for row in "${matches[@]}"; do
    IFS='|' read -r tid label category script in_exts out_ext status <<< "$row"
    if [[ "$status" == "ready" ]] && _mango_script_ready "$script"; then
      menu_items+=("${label}|ready")
    else
      menu_items+=("${label}|soon")
    fi
    ((i++)) || true
  done
  menu_items+=("Back|")

  local choice
  ui_menu_select choice page tools "Available conversions for .${file_ext}" "${menu_items[@]}"
  if [[ "$choice" -eq ${#menu_items[@]} ]]; then
    return 0
  fi

  local selected="${matches[$((choice - 1))]}"
  IFS='|' read -r tid _ _ _ _ _ status <<< "$selected"

  if [[ "$status" != "ready" ]]; then
    ui_message info "That conversion is coming soon."
    ui_pause
    return 0
  fi

  _mango_run_conversion "$tid"
}

# ── Category browser ────────────────────────────────────────────────────────────

_mango_category_menu() {
  local cat="$1"
  _MANGO_CAT_NAME="$cat"
  _MANGO_PAGE_DRAW_FN=_mango_category_draw_page
  MANGO_MENU_FOOTER="${MANGO_DIM}● ready   ○ coming soon${MANGO_RESET}"

  local -a in_cat=()
  local row tid label category script in_exts out_ext status
  for row in "${MANGO_TOOLS[@]}"; do
    IFS='|' read -r tid label category script in_exts out_ext status <<< "$row"
    if [[ "$category" == "$cat" ]]; then
      in_cat+=("$row")
    fi
  done

  if [[ ${#in_cat[@]} -eq 0 ]]; then
    ui_message info "No tools in this category yet."
    ui_pause
    return 0
  fi

  local -a menu_items=()
  for row in "${in_cat[@]}"; do
    IFS='|' read -r tid label category script in_exts out_ext status <<< "$row"
    if [[ "$status" == "ready" ]] && _mango_script_ready "$script"; then
      menu_items+=("${label}|ready")
    else
      menu_items+=("${label}|soon")
    fi
  done
  menu_items+=("Back|")

  local choice
  ui_menu_select choice page tools "$cat" "${menu_items[@]}"
  if [[ "$choice" -eq ${#menu_items[@]} ]]; then
    return 0
  fi

  local selected="${in_cat[$((choice - 1))]}"
  IFS='|' read -r tid _ _ _ _ _ status <<< "$selected"

  if [[ "$status" != "ready" ]]; then
    ui_message info "This tool is coming soon."
    ui_pause
    return 0
  fi

  _mango_run_conversion "$tid"
}

# ── Main menu ───────────────────────────────────────────────────────────────────

_mango_main_menu() {
  _MANGO_PAGE_DRAW_FN=""
  MANGO_MENU_FOOTER=""

  local choice
  ui_menu_select choice home main "Main Menu" \
    "Quick Convert|pick a file → see all options" \
    "Video & Audio|GIF, compress, extract audio, trim" \
    "PDF Toolkit|convert, merge, compress" \
    "Image Toolkit|compress, convert formats" \
    "Developer|JSON, base64, hashes" \
    "Exit|"

  case "$choice" in
    6) _mango_exit_app ;;
    1) _mango_quick_convert ;;
    2) _mango_category_menu "Video & Audio" ;;
    3) _mango_category_menu "PDF" ;;
    4) _mango_category_menu "Image" ;;
    5) _mango_category_menu "Developer" ;;
  esac
}

# ── Entry ───────────────────────────────────────────────────────────────────────

main() {
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "Mango is an interactive terminal UI. Run it directly in your terminal:"
    echo "  mango"
    exit 1
  fi

  while true; do
    _mango_main_menu
  done
}

main "$@"
